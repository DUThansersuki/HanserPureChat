  classDef data fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef remote fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  class main,ui,next shell
  class agent,bridge core
  class jobs,tts speech
  class db,disk,assets data
  class llm remote
