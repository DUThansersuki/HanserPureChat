HANSER_VOICE_HOST=127.0.0.1
HANSER_VOICE_PORT=8770
HANSER_VOICE_INTERNAL_TOKEN=
HANSER_VOICE_DATA_ROOT=voice_runtime/data
HANSER_VOICE_PROFILE=voice_runtime/config/voice_profile.candidate.yml
# GPT-SoVITS candidate (keep disabled until assets and weights are approved):
# HANSER_VOICE_PROFILE=voice_runtime/config/voice_profile.gpt-sovits-v2pro.candidate.yml
HANSER_RIG_PROFILE=voice_runtime/config/rig_profile.candidate.yml

# Only set true after the voice profile and reviewed asset manifest are enabled.
HANSER_VOICE_LOAD_MODEL=false

HANSER_VOICE_MAX_PENDING_JOBS=8
HANSER_VOICE_MAX_TEXT=4000
HANSER_VOICE_EVENT_WINDOW=256
HANSER_VOICE_MAX_READY_SEGMENTS=2
HANSER_VOICE_INTERACTIVE_DEADLINE=120
HANSER_VOICE_OFFLINE_DEADLINE=900
